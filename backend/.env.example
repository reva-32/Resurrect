# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=

# Razorpay (Test Mode keys — from Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Auth
JWT_SECRET=replace-with-a-long-random-string

# AI (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Demo customer (used only for the controlled live/test payment flow)
DEMO_PHONE=+91XXXXXXXXXX
DEMO_NAME=Your Name

# SMS provider (real provider can be added later; mock mode is the default)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
SMS_MOCK_MODE=true
